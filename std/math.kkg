// std/math — integer helpers.
//
// Only `pub` items are reachable from another module; everything else here is
// private to std/math.

pub fn abs(n: int) -> int {
    if n < 0 {
        return 0 - n
    }
    return n
}

pub fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

pub fn clamp(n: int, lo: int, hi: int) -> int {
    return min(max(n, lo), hi)
}

pub fn pow(base: int, exp: int) -> int {
    let mut result = 1
    for _i in 0..exp {
        result = result * base
    }
    return result
}

pub fn gcd(a: int, b: int) -> int {
    let mut x = abs(a)
    let mut y = abs(b)
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}

// Not `pub`: an implementation detail, and a compile error to call from outside.
fn isEven(n: int) -> bool {
    return n % 2 == 0
}

pub fn sumEvens(upto: int) -> int {
    let mut total = 0
    for n in 0..upto {
        if isEven(n) {
            total = total + n
        }
    }
    return total
}
