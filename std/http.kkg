// std/http — just enough HTTP/1.1 to serve requests.
//
// Pure Klang on top of std/net and std/string. No unsafe here at all: std/net
// already discharged that, so this module is ordinary code.

import "std/net"
import "std/string" as str

pub struct Request {
    method: string,
    path: string,
    query: string,
    headers: {string: string},
    // Whatever `:name` in the route matched. Empty for a route with none.
    params: {string: string},
    body: string,
}

pub struct Response {
    status: int,
    contentType: string,
    // Whole header lines, "Name: Value". An API needs to say things the four
    // fixed headers cannot — CORS, caching, a Location — and a list of lines is
    // the smallest thing that lets it.
    extra: [string],
    body: string,
}

fn plain(status: int, body: string) -> Response {
    return Response { status: status, contentType: "text/plain; charset=utf-8",
                      extra: [], body: body }
}

pub fn ok(body: string) -> Response { return plain(200, body) }

pub fn html(body: string) -> Response {
    return Response { status: 200, contentType: "text/html; charset=utf-8",
                      extra: [], body: body }
}
pub fn json(body: string) -> Response {
    return Response { status: 200, contentType: "application/json",
                      extra: [], body: body }
}
pub fn notFound() -> Response { return plain(404, "not found\n") }
pub fn badRequest(why: string) -> Response { return plain(400, "${why}\n") }
pub fn notAllowed() -> Response { return plain(405, "method not allowed\n") }
pub fn noContent() -> Response { return plain(204, "") }

// Any status you like, when the named ones do not fit.
pub fn reply(status: int, contentType: string, body: string) -> Response {
    return Response { status: status, contentType: contentType, extra: [], body: body }
}

pub fn with(r: Response, name: string, value: string) -> Response {
    let mut lines: [string] = []
    for h in r.extra {
        push(lines, h)
    }
    push(lines, "${name}: ${value}")
    return Response { status: r.status, contentType: r.contentType,
                      extra: lines, body: r.body }
}

// A browser will not let a page on one origin read a reply from another unless
// the reply says so. Spelled out here so an API does not have to remember the
// header names.
pub fn allowOrigin(r: Response, origin: string) -> Response {
    return with(with(with(r, "Access-Control-Allow-Origin", origin),
                     "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS"),
                "Access-Control-Allow-Headers", "Content-Type")
}

fn reasonFor(status: int) -> string {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 400 { return "Bad Request" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 500 { return "Internal Server Error" }
    return "OK"
}

pub fn parseRequest(raw: string) -> Result<Request, string> {
    let cut = raw.indexOf("\r\n\r\n")
    let mut head = raw
    let mut body = ""
    if cut >= 0 {
        head = raw.substr(0, cut)
        body = raw.substr(cut + 4, raw.len())
    }

    let lines = head.split("\r\n")
    if lines.len() == 0 || lines[0].len() == 0 {
        return Err("empty request")
    }
    let parts = lines[0].split(" ")
    if parts.len() < 2 {
        return Err("malformed request line")
    }
    let target = parts[1]
    let q = target.indexOf("?")
    let mut path = target
    let mut query = ""
    if q >= 0 {
        path = target.substr(0, q)
        query = target.substr(q + 1, target.len())
    }

    let mut headers: {string: string} = {}
    for i in 1..lines.len() {
        let line = lines[i]
        let colon = line.indexOf(":")
        if colon > 0 {
            let name = line.substr(0, colon).toLower()
            headers[name] = line.substr(colon + 1, line.len()).trim()
        }
    }
    let empty: {string: string} = {}
    return Ok(Request { method: parts[0], path: path, query: query,
                        headers: headers, params: empty, body: body })
}

pub fn render(r: Response) -> string {
    let mut out = "HTTP/1.1 ${r.status} ${reasonFor(r.status)}\r\n"
                + "Content-Type: ${r.contentType}\r\n"
                + "Content-Length: ${r.body.len()}\r\n"
                + "Connection: close\r\n"
    for h in r.extra {
        out = out + h + "\r\n"
    }
    return out + "\r\n" + r.body
}

// Reads one request off the connection, hands it to `handle`, writes the reply.
// ── routes ────────────────────────────────────────────────────────────
//
//     http.serve(8099, [
//         http.get("/api/tasks", listTasks),
//         http.post("/api/tasks", createTask),
//         http.put("/api/tasks/:id", updateTask),
//         http.remove("/api/tasks/:id", deleteTask),
//     ])
//
// A table rather than a chain of ifs, because the chain has to get four things
// right every time and quietly gets them wrong: a path that exists but not for
// this method is a 405 and not a 404, OPTIONS has to be answered before a browser
// will send anything interesting, and both have to happen for every route rather
// than the ones you remembered.

pub struct Route {
    method: string,
    pattern: string,
    run: fn(Request) -> Response,
}

pub fn on(method: string, pattern: string, run: fn(Request) -> Response) -> Route {
    return Route { method: method, pattern: pattern, run: run }
}

pub fn get(pattern: string, run: fn(Request) -> Response) -> Route {
    return on("GET", pattern, run)
}
pub fn post(pattern: string, run: fn(Request) -> Response) -> Route {
    return on("POST", pattern, run)
}
pub fn put(pattern: string, run: fn(Request) -> Response) -> Route {
    return on("PUT", pattern, run)
}
// Not `delete`: that reads as a verb the language might want one day.
pub fn remove(pattern: string, run: fn(Request) -> Response) -> Route {
    return on("DELETE", pattern, run)
}

// "/api/tasks/:id" against "/api/tasks/7" gives {"id": "7"}. A segment count
// mismatch is not a match, so "/api/tasks" never reaches a route expecting an id.
fn match1(pattern: string, path: string) -> Option<{string: string}> {
    let want = pattern.split("/")
    let got = path.split("/")
    if want.len() != got.len() {
        return None
    }
    let mut params: {string: string} = {}
    for i in 0..want.len() {
        if want[i].startsWith(":") {
            params[want[i].substr(1, want[i].len())] = got[i]
        } else if want[i] != got[i] {
            return None
        }
    }
    return Some(params)
}

fn withParams(r: Request, params: {string: string}) -> Request {
    return Request { method: r.method, path: r.path, query: r.query,
                     headers: r.headers, params: params, body: r.body }
}

// Picks the route and produces the reply, including the two answers people forget.
pub fn dispatch(routes: [Route], req: Request) -> Response {
    let mut pathMatched = false
    for r in routes {
        match match1(r.pattern, req.path) {
            None => { }
            Some(params) => {
                pathMatched = true
                if r.method == req.method {
                    return r.run(withParams(req, params))
                }
                // A browser asks before a cross-origin POST, and will not send
                // one until this is answered.
                if req.method == "OPTIONS" {
                    return noContent()
                }
            }
        }
    }
    if pathMatched {
        return notAllowed()
    }
    return notFound()
}

pub fn serveOne(c: net.Conn, handle: fn(Request) -> Response) {
    match net.readSome(c) {
        Ok(raw) => {
            let reply = match parseRequest(raw) {
                Ok(req) => handle(req),
                Err(e)  => badRequest(e),
            }
            net.writeAll(c, render(reply))
        }
        Err(_e) => { }
    }
    net.closeConn(c)
}

// ── serving ───────────────────────────────────────────────────────────
//
// The accept loop is the same in every server, so it lives here. `serve` returns
// only if the port cannot be opened, and says why.

fn loopOn(listener: net.Listener, routes: [Route], origin: string) {
    while true {
        match net.acceptOne(listener) {
            Err(e)   => println("accept: ${e}")
            Ok(conn) => {
                serveOne(conn, |req| {
                    let reply = dispatch(routes, req)
                    // The CORS headers go on every reply including the failures.
                    // A 404 the browser will not let the page read is a 404
                    // nobody can debug.
                    return if origin == "" { reply } else { allowOrigin(reply, origin) }
                })
            }
        }
    }
}

pub fn serve(port: int, routes: [Route]) -> Result<int, string> {
    match net.listenOn(port) {
        Err(e) => { return Err(e) }
        Ok(listener) => {
            println("listening on http://127.0.0.1:${port}")
            loopOn(listener, routes, "")
            net.closeListener(listener)
            return Ok(port)
        }
    }
}

// The same, but every reply says any origin may read it. Named so that choosing
// it is visible: it is the right default for a development API and the wrong one
// for anything holding a session.
pub fn serveOpen(port: int, routes: [Route]) -> Result<int, string> {
    match net.listenOn(port) {
        Err(e) => { return Err(e) }
        Ok(listener) => {
            println("listening on http://127.0.0.1:${port}  (open to any origin)")
            loopOn(listener, routes, "*")
            net.closeListener(listener)
            return Ok(port)
        }
    }
}
