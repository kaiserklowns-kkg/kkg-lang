// std/html — HTML as Klang values, not as strings.
//
//     html.div([html.class("card")], [
//         html.h1([], [html.text(title)]),
//         html.button([html.on("click", "addTask")], [html.text("add")]),
//     ])
//
// Two things follow from it being a value rather than text.
//
// **Escaping is structural.** A `text` node is escaped when it is rendered, so
// there is no way to forget — the only path to unescaped output is `raw`, which
// you have to type on purpose. Attribute values are escaped the same way.
//
// **Handlers are attached where the element is built.** `on("click", "addTask")`
// becomes a `data-on-click` attribute; one listener at the root reads it and calls
// that `export fn`. So a button does not need an id, a selector, or a matching
// line somewhere else in `main`.
//
// A Node contains Elements which contain Nodes — recursion through an array,
// which is a reference, so there is no infinite layout.

import "std/string" as str

pub struct Attr {
    name: string,
    value: string,
}

pub struct Element {
    tag: string,
    attrs: [Attr],
    kids: [Node],
}

pub enum Node {
    Text(string),
    Raw(string),
    Elem(Element),
}

// ── building ──────────────────────────────────────────────────────────

pub fn text(s: string) -> Node {
    return Text(s)
}

// Unescaped, and named so that it looks like what it is at the call site.
pub fn raw(markup: string) -> Node {
    return Raw(markup)
}

pub fn el(tag: string, attrs: [Attr], kids: [Node]) -> Node {
    return Elem(Element { tag: tag, attrs: attrs, kids: kids })
}

// ── attributes ────────────────────────────────────────────────────────

pub fn attr(name: string, value: string) -> Attr {
    return Attr { name: name, value: value }
}

pub fn class(c: string) -> Attr { return attr("class", c) }
pub fn id(v: string) -> Attr { return attr("id", v) }
pub fn href(v: string) -> Attr { return attr("href", v) }
pub fn src(v: string) -> Attr { return attr("src", v) }
pub fn alt(v: string) -> Attr { return attr("alt", v) }
pub fn title(v: string) -> Attr { return attr("title", v) }
pub fn type_(v: string) -> Attr { return attr("type", v) }
pub fn name(v: string) -> Attr { return attr("name", v) }
pub fn value(v: string) -> Attr { return attr("value", v) }
pub fn placeholder(v: string) -> Attr { return attr("placeholder", v) }
pub fn style(v: string) -> Attr { return attr("style", v) }

// A bare attribute renders as name="name", which is how HTML spells a flag.
pub fn flag(n: string) -> Attr { return attr(n, n) }

// `handler` names an `export fn`. Without an `arg`, one taking nothing; with one,
// one taking a single string.
pub fn on(event: string, handler: string) -> Attr {
    return attr("data-on-" + event, handler)
}

pub fn arg(v: string) -> Attr { return attr("data-arg", v) }

// ── the tags worth having by name ──────────────────────────────────────

pub fn div(a: [Attr], k: [Node]) -> Node { return el("div", a, k) }
pub fn span(a: [Attr], k: [Node]) -> Node { return el("span", a, k) }
pub fn p(a: [Attr], k: [Node]) -> Node { return el("p", a, k) }
pub fn h1(a: [Attr], k: [Node]) -> Node { return el("h1", a, k) }
pub fn h2(a: [Attr], k: [Node]) -> Node { return el("h2", a, k) }
pub fn h3(a: [Attr], k: [Node]) -> Node { return el("h3", a, k) }
pub fn ul(a: [Attr], k: [Node]) -> Node { return el("ul", a, k) }
pub fn ol(a: [Attr], k: [Node]) -> Node { return el("ol", a, k) }
pub fn li(a: [Attr], k: [Node]) -> Node { return el("li", a, k) }
pub fn a(at: [Attr], k: [Node]) -> Node { return el("a", at, k) }
pub fn button(at: [Attr], k: [Node]) -> Node { return el("button", at, k) }
pub fn form(at: [Attr], k: [Node]) -> Node { return el("form", at, k) }
pub fn label(at: [Attr], k: [Node]) -> Node { return el("label", at, k) }
pub fn nav(at: [Attr], k: [Node]) -> Node { return el("nav", at, k) }
pub fn header(at: [Attr], k: [Node]) -> Node { return el("header", at, k) }
pub fn footer(at: [Attr], k: [Node]) -> Node { return el("footer", at, k) }
pub fn section(at: [Attr], k: [Node]) -> Node { return el("section", at, k) }
pub fn main_(at: [Attr], k: [Node]) -> Node { return el("main", at, k) }
pub fn table(at: [Attr], k: [Node]) -> Node { return el("table", at, k) }
pub fn tr(at: [Attr], k: [Node]) -> Node { return el("tr", at, k) }
pub fn td(at: [Attr], k: [Node]) -> Node { return el("td", at, k) }
pub fn th(at: [Attr], k: [Node]) -> Node { return el("th", at, k) }
pub fn pre(at: [Attr], k: [Node]) -> Node { return el("pre", at, k) }
pub fn code(at: [Attr], k: [Node]) -> Node { return el("code", at, k) }
pub fn strong(at: [Attr], k: [Node]) -> Node { return el("strong", at, k) }
pub fn em(at: [Attr], k: [Node]) -> Node { return el("em", at, k) }

// Void elements take no children, so they do not offer a slot for any.
pub fn input(at: [Attr]) -> Node { return el("input", at, []) }
pub fn img(at: [Attr]) -> Node { return el("img", at, []) }
pub fn br() -> Node { return el("br", [], []) }
pub fn hr() -> Node { return el("hr", [], []) }

// ── rendering ─────────────────────────────────────────────────────────

fn escapeText(s: string) -> string {
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
}

fn escapeAttr(s: string) -> string {
    return escapeText(s).replace("\"", "&quot;").replace("'", "&#39;")
}

fn isVoid(tag: string) -> bool {
    for v in ["area", "base", "br", "col", "embed", "hr", "img", "input",
              "link", "meta", "source", "track", "wbr"] {
        if tag == v {
            return true
        }
    }
    return false
}

pub fn render(n: Node) -> string {
    return match n {
        Text(s)  => escapeText(s),
        Raw(m)   => m,
        Elem(e)  => renderElement(e),
    }
}

fn renderElement(e: Element) -> string {
    let mut out = "<" + e.tag
    for at in e.attrs {
        out = out + " " + at.name + "=\"" + escapeAttr(at.value) + "\""
    }
    if isVoid(e.tag) {
        return out + ">"
    }
    out = out + ">"
    for k in e.kids {
        out = out + render(k)
    }
    return out + "</" + e.tag + ">"
}

// A list of siblings with no wrapper, for filling a container that already exists.
pub fn renderAll(ns: [Node]) -> string {
    let mut out = ""
    for n in ns {
        out = out + render(n)
    }
    return out
}
