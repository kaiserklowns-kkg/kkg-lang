// std/fetch — HTTP from a browser.
//
//     fetch.get("/api/items",
//         |body| { items = parse(body); ui.refresh() },
//         |why|  { message = "could not load: ${why}"; ui.refresh() })
//
// The handlers are closures, the same as everywhere else. JavaScript never holds
// one: they go into a Klang array and the request carries an index, which is the
// trick std/ui uses for events and works just as well across a round trip.
//
// Why not `let body = fetch.get(url)?`, which would read better? Because making a
// wasm call block on a promise means Emscripten's Asyncify, and Asyncify unwinds
// the shadow stack — where this collector's root frames live. While a call is
// suspended those frames point at memory a later call will reuse, so a collection
// triggered by any other handler in the meantime would walk garbage. A callback
// starts a fresh Klang call with a fresh frame, exactly like a click does, and has
// no such window. If Klang ever gets a blocking form, it will be after the
// collector can be told to stand down across a suspension.
//
// Failure is never silent: every call names an error handler, and a non-2xx reply
// is a failure rather than a body you might mistake for data.

// A single primitive; the shapes below are conveniences over it.
js fn jsSend(method: string, url: string, body: string, contentType: string,
             slot: int) {
    var init = { method: method }
    if (method !== "GET" && method !== "HEAD") {
        init.body = body
        init.headers = { "Content-Type": contentType }
    }
    var done = function(ok, text) {
        Module.ccall("klangFetchDone", null, ["number", "number", "string"],
                     [slot, ok ? 1 : 0, String(text)])
    }
    fetch(url, init).then(function(res) {
        return res.text().then(function(text) {
            if (res.ok) done(true, text)
            else done(false, res.status + " " + (res.statusText || "request failed"))
        })
    }).catch(function(e) {
        done(false, e && e.message ? e.message : e)
    })
}

// A request in flight: the two closures waiting for it. The slot is what crosses
// to JavaScript, so nothing of Klang's does.
struct Waiting {
    ok: fn(string),
    err: fn(string),
    live: bool,
}

let mut waiting: [Waiting] = []

// Called from JavaScript when a request finishes, either way.
export fn klangFetchDone(slot: int, ok: int, text: string) {
    if slot < 0 || slot >= waiting.len() || !waiting[slot].live {
        return
    }
    let w = waiting[slot]
    // Cleared before the handler runs, so a handler that starts another request
    // can reuse this slot, and so a duplicate reply cannot fire it twice.
    waiting[slot] = Waiting { ok: w.ok, err: w.err, live: false }
    if ok == 1 {
        w.ok(text)
    } else {
        w.err(text)
    }
}

fn park(ok: fn(string), err: fn(string)) -> int {
    for i in 0..waiting.len() {
        if !waiting[i].live {
            waiting[i] = Waiting { ok: ok, err: err, live: true }
            return i
        }
    }
    push(waiting, Waiting { ok: ok, err: err, live: true })
    return waiting.len() - 1
}

// `ok` is given the response body; `err` the reason it did not arrive.

pub fn get(url: string, ok: fn(string), err: fn(string)) {
    unsafe { jsSend("GET", url, "", "", park(ok, err)) }
}

pub fn post(url: string, body: string, ok: fn(string), err: fn(string)) {
    unsafe { jsSend("POST", url, body, "application/json", park(ok, err)) }
}

pub fn put(url: string, body: string, ok: fn(string), err: fn(string)) {
    unsafe { jsSend("PUT", url, body, "application/json", park(ok, err)) }
}

pub fn del(url: string, ok: fn(string), err: fn(string)) {
    unsafe { jsSend("DELETE", url, "", "", park(ok, err)) }
}

// Everything else: your own method, body and content type.
pub fn send(method: string, url: string, body: string, contentType: string,
            ok: fn(string), err: fn(string)) {
    unsafe { jsSend(method, url, body, contentType, park(ok, err)) }
}
