import "std/ui"
struct Task { id: int, title: string, done: bool }
let mut tasks: [Task] = []
let mut nextId = 1
fn toggle(id: int) {
    for i in 0..tasks.len() {
        if tasks[i].id == id { tasks[i] = Task { id: id, title: tasks[i].title, done: !tasks[i].done } }
    }
    ui.refresh()
}
fn drop(id: int) {
    for i in 0..tasks.len() {
        if tasks[i].id == id { remove(tasks, i); break }
    }
    ui.refresh()
}
fn add() {
    let t = ui.valueOf("#entry")
    if t != "" { push(tasks, Task { id: nextId, title: t, done: false }); nextId += 1 }
    ui.refresh()
}
fn row(t: Task) -> ui.Node {
    return ui.keyed(ui.item([
        ui.button(if t.done { "done" } else { "todo" }, || toggle(t.id)),
        ui.tag("span", t.title),
        ui.button("x", || drop(t.id)),
    ]), "${t.id}")
}
fn view() -> ui.Node {
    let mut rows: [ui.Node] = []
    for t in tasks { push(rows, row(t)) }
    return ui.col([
        ui.h1("Tasks"),
        ui.onSubmit(ui.form([
            ui.input([ui.id("entry"), ui.placeholder("what?")]),
            ui.tag("button", "add"),
        ]), add),
        ui.list(rows),
        ui.line("${tasks.len()} tasks"),
    ])
}
fn main() {
    push(tasks, Task { id: 1, title: "first", done: false })
    push(tasks, Task { id: 2, title: "second", done: true })
    nextId = 3
    ui.mount("#app", view)
}
