// The API half of the full-stack example: a REST service, in Klang, compiled to
// a native executable.
//
//     klangc run examples/fullstack/api.kkg
//
//     GET    /api/tasks        every task, as JSON
//     POST   /api/tasks        {"title": "..."} -> the task that was created
//     PUT    /api/tasks/:id    {"done": true}   -> the task that was changed
//     DELETE /api/tasks/:id    removes it
//     GET    /api/health       a heartbeat, with the heap size
//
// Nothing here is unsafe and nothing here is about memory or sockets. The routing
// table is the program; std/http does the accepting, the 404s, the 405s and the
// preflight, because getting those wrong is the normal outcome of writing them by
// hand each time.

import "std/http"
import "std/json"
import "std/string" as str

struct Task {
    id: int,
    title: string,
    done: bool,
}

let mut tasks: [Task] = []
let mut nextId = 1

fn asJson(t: Task) -> json.Json {
    return Obj([json.num("id", t.id), json.text("title", t.title),
                json.flag("done", t.done)])
}

fn indexOfId(id: int) -> int {
    for i in 0..tasks.len() {
        if tasks[i].id == id {
            return i
        }
    }
    return -1
}

fn idOf(req: http.Request) -> int {
    return match str.parseInt(req.params["id"]) {
        Ok(n)  => n,
        Err(_) => -1,
    }
}

// ── the handlers ──────────────────────────────────────────────────────

fn listTasks(_req: http.Request) -> http.Response {
    let mut out: [json.Json] = []
    for t in tasks {
        push(out, asJson(t))
    }
    return http.json(json.array(out))
}

fn createTask(req: http.Request) -> http.Response {
    match json.parse(req.body) {
        Err(e) => { return http.badRequest("body is not JSON: ${e}") }
        Ok(doc) => {
            let title = str.trim(json.textAt(doc, "title"))
            if title == "" {
                return http.badRequest("a task needs a title")
            }
            let t = Task { id: nextId, title: title, done: false }
            nextId += 1
            push(tasks, t)
            return http.reply(201, "application/json", json.stringify(asJson(t)))
        }
    }
}

fn updateTask(req: http.Request) -> http.Response {
    let i = indexOfId(idOf(req))
    if i < 0 {
        return http.notFound()
    }
    match json.parse(req.body) {
        Err(e) => { return http.badRequest("body is not JSON: ${e}") }
        Ok(doc) => {
            tasks[i] = Task { id: tasks[i].id, title: tasks[i].title,
                              done: json.boolAt(doc, "done") }
            return http.json(json.stringify(asJson(tasks[i])))
        }
    }
}

fn deleteTask(req: http.Request) -> http.Response {
    let i = indexOfId(idOf(req))
    if i < 0 {
        return http.notFound()
    }
    remove(tasks, i)
    return http.noContent()
}

fn health(_req: http.Request) -> http.Response {
    return http.json(json.object([
        json.flag("ok", true),
        json.num("tasks", tasks.len()),
        json.num("heapBytes", gcHeap()),
    ]))
}

fn main() {
    push(tasks, Task { id: 1, title: "write a language", done: true })
    push(tasks, Task { id: 2, title: "give it a garbage collector", done: true })
    push(tasks, Task { id: 3, title: "serve an API from it", done: false })
    nextId = 4

    match http.serveOpen(8099, [
        http.get("/api/tasks", listTasks),
        http.post("/api/tasks", createTask),
        http.put("/api/tasks/:id", updateTask),
        http.remove("/api/tasks/:id", deleteTask),
        http.get("/api/health", health),
    ]) {
        Ok(_)  => { }
        Err(e) => println("cannot start: ${e}")
    }
}
