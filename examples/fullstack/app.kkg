// The UI half of the full-stack example. Same language as the API next to it —
// this one compiles to WebAssembly instead of a binary.
//
//     klangc run examples/fullstack/api.kkg      # one terminal
//     web run examples/fullstack/app.kkg         # another
//
// There is no local copy of the data. Every change goes to the server and the
// list is whatever the server last said it was, which is the only way a second
// browser tab does not show something different.

import "std/ui"
import "std/dom"
import "std/fetch"
import "std/json"
import "std/list"
import "std/string" as str

const API = "http://127.0.0.1:8099/api"

struct Task {
    id: int,
    title: string,
    done: bool,
}

let mut tasks: [Task] = []
let mut status = "loading…"
let mut busy = false

// ── talking to the server ─────────────────────────────────────────────
//
// One place decides what a reply means, so no request can quietly do nothing.

fn tookList(body: string) {
    match json.parse(body) {
        Err(e) => { status = "server sent something odd: ${e}" }
        Ok(doc) => {
            tasks = []
            for item in json.items(doc) {
                push(tasks, Task { id: json.intAt(item, "id"),
                                   title: json.textAt(item, "title"),
                                   done: json.boolAt(item, "done") })
            }
            status = "${tasks.len()} from the server"
        }
    }
    busy = false
    ui.refresh()
}

fn failed(why: string) {
    status = "the API is not answering: ${why}"
    busy = false
    ui.refresh()
}

fn reload() {
    busy = true
    ui.refresh()
    fetch.get("${API}/tasks", tookList, failed)
}

// Every change is followed by a reload, so what is on screen is what the server
// has rather than what this page hoped it would have.
fn afterChange(_body: string) { reload() }

fn add() {
    let title = str.trim(ui.valueOf("#entry"))
    if title == "" {
        status = "type something first"
        ui.refresh()
        return
    }
    busy = true
    dom.setValue("#entry", "")
    ui.focus("#entry")
    ui.refresh()
    fetch.post("${API}/tasks", json.object([json.text("title", title)]),
               afterChange, failed)
}

fn toggle(t: Task) {
    busy = true
    ui.refresh()
    fetch.put("${API}/tasks/${t.id}", json.object([json.flag("done", !t.done)]),
              afterChange, failed)
}

fn removeTask(id: int) {
    busy = true
    ui.refresh()
    fetch.del("${API}/tasks/${id}", afterChange, failed)
}

fn checkHealth() {
    fetch.get("${API}/health",
        |body| {
            match json.parse(body) {
                Err(e)  => { status = "health check unreadable: ${e}" }
                Ok(doc) => { status = "server: ${json.intAt(doc, "tasks")} tasks, "
                                    + "${json.intAt(doc, "heapBytes")} bytes of heap" }
            }
            ui.refresh()
        },
        failed)
}

// ── the page ──────────────────────────────────────────────────────────
//
// Styling is Tailwind. The class names are in these string literals, and
// web/input.css points Tailwind at this file with @source, which is what makes
// them reach the stylesheet.

const BTN = "rounded border border-gray-400/50 px-3 py-1.5 hover:bg-gray-500/10"
const ICON = "px-2 opacity-60 hover:opacity-100"

fn row(t: Task) -> ui.Node {
    return ui.keyed(ui.with(ui.item([
        ui.with(ui.button(if t.done { "☑" } else { "☐" }, || toggle(t)), [ui.class(ICON)]),
        ui.with(ui.tag("span", t.title),
                [ui.class(if t.done { "flex-1 opacity-45 line-through" } else { "flex-1" })]),
        ui.with(ui.button("×", || removeTask(t.id)), [ui.class(ICON)]),
    ]), [ui.class("flex items-center gap-2 border-b border-gray-500/20 px-2 py-1.5 "
                + "last:border-0")]), "${t.id}")
}

fn view() -> ui.Node {
    let left = list.count(tasks, |t| !t.done)
    return ui.col([
        ui.with(ui.h1("Klang, end to end"), [ui.class("text-2xl font-semibold")]),
        ui.with(ui.line("This page is WebAssembly. The API it talks to is a native "
                      + "binary. Both are Klang, and neither knows the other is."),
                [ui.class("mt-1 text-sm opacity-70")]),

        ui.with(ui.onSubmit(ui.form([
            ui.with(ui.input([ui.id("entry"), ui.placeholder("something to do"),
                              ui.attr("autocomplete", "off")]),
                    [ui.class("flex-1 rounded border border-gray-400/50 bg-transparent "
                            + "px-3 py-1.5")]),
            ui.with(ui.tag("button", "add"), [ui.class(BTN)]),
        ]), add), [ui.class("mt-6 flex gap-2")]),

        ui.with(if tasks.len() == 0 {
            ui.list([ui.with(ui.item([ui.text("nothing here")]),
                             [ui.class("justify-center px-2 py-1.5 italic opacity-50")])])
        } else {
            ui.list(list.map(tasks, row))
        }, [ui.class("mt-3 rounded border border-gray-500/30")]),

        ui.with(ui.div([
            ui.tag("span", "${left} of ${tasks.len()} left"),
            ui.with(ui.tag("span", if busy { "…" } else { status }),
                    [ui.class("flex-1 text-center")]),
            ui.with(ui.span([ui.with(ui.button("reload", reload), [ui.class(BTN)]),
                             ui.with(ui.button("health", checkHealth), [ui.class(BTN)])]),
                    [ui.class("flex gap-2")]),
        ]), [ui.id("status"), ui.class("mt-3 flex items-center gap-2 text-sm opacity-75")]),
    ])
}

// Readable from JavaScript, so a test can ask the page what it thinks it has.
export fn taskCount() -> int {
    return tasks.len()
}

fn main() {
    dom.setTitle("Klang, end to end")
    ui.mount("#app", view)
    reload()
}
