// A web application written entirely in Klang.
//
// There is no .html file and no .css file. The markup is std/ui, the styling is
// std/css, and klangc writes the page shell at build time. Handlers are closures;
// changing state and calling `ui.refresh()` patches the DOM rather than rebuilding
// it, so what you are typing into the box survives every re-render.
//
//     klangc web run examples/web.kkg

import "std/ui"
import "std/css"
import "std/dom"
import "std/fetch"
import "std/list"
import "std/json"
import "std/string" as str

struct Task {
    id: int,
    title: string,
    done: bool,
}

// State is ordinary Klang. It lives at module level because a handler runs long
// after main returned and cannot capture a local.
let mut tasks: [Task] = []
let mut nextId = 1
let mut filter = "all"
let mut message = ""

const STORE_KEY = "klang.tasks"

// ── the page ──────────────────────────────────────────────────────────

fn taskRow(t: Task) -> ui.Node {
    // A key tells the diff which row is which, so deleting from the middle of the
    // list moves nothing else.
    return ui.keyed(ui.with(ui.item([
        ui.with(ui.button(if t.done { "☑" } else { "☐" }, || toggle(t.id)),
                [ui.class("mark"), ui.title("toggle")]),
        // A text node is escaped on the way in. There is no way to forget.
        ui.tag("span", t.title),
        ui.with(ui.button("×", || removeTask(t.id)),
                [ui.class("delete"), ui.title("delete")]),
    ]), [ui.class(if t.done { "task done" } else { "task" })]), "${t.id}")
}

fn visible() -> [Task] {
    if filter == "done" {
        return list.filter(tasks, |t| t.done)
    }
    if filter == "todo" {
        return list.filter(tasks, |t| !t.done)
    }
    return tasks
}

fn filterLink(name: string, label: string) -> ui.Node {
    let target = if name == "all" { "#" } else { "#${name}" }
    return ui.with(ui.link(label, target),
                   [ui.class(if filter == name { "on" } else { "" })])
}

fn listView() -> ui.Node {
    let shown = visible()
    if shown.len() == 0 {
        return ui.list([ui.with(ui.item([ui.text("nothing here")]), [ui.class("empty")])])
    }
    return ui.list(list.map(shown, taskRow))
}

fn view() -> ui.Node {
    let left = list.count(tasks, |t| !t.done)
    return ui.col([
        ui.h1("Klang in the browser"),
        ui.with(ui.line("Markup, styling, state, routing and the network are "
                      + "examples/web.kkg — Klang values, compiled to WebAssembly."),
                [ui.class("sub")]),

        ui.onSubmit(ui.form([
            ui.onKey(ui.input([ui.id("entry"),
                               ui.placeholder("something to do — esc to clear"),
                               ui.attr("autocomplete", "off")]),
                     |key| { if key == "Escape" { clearEntry() } }),
            ui.tag("button", "add"),
        ]), addTask),

        ui.nav([filterLink("all", "all"), filterLink("todo", "todo"),
                filterLink("done", "done")]),

        listView(),

        ui.with(ui.div([
            ui.tag("span", "${left} of ${tasks.len()} left"),
            ui.with(ui.tag("span", message), [ui.class("message")]),
            ui.span([
                ui.button("sync", sync),
                ui.button("clear done", clearDone),
            ]),
        ]), [ui.class("status")]),
    ])
}

// ── what the handlers do ──────────────────────────────────────────────
//
// Plain functions. They change state, save, and refresh; the diff works out what
// that means for the DOM.

fn addTask() {
    let title = str.trim(ui.valueOf("#entry"))
    if title == "" {
        message = "type something first"
        ui.refresh()
        return
    }
    push(tasks, Task { id: nextId, title: title, done: false })
    nextId += 1
    message = ""
    dom.setValue("#entry", "")
    ui.focus("#entry")
    save()
    ui.refresh()
}

fn clearEntry() {
    dom.setValue("#entry", "")
    message = ""
    ui.refresh()
}

fn toggle(id: int) {
    let i = indexOfId(id)
    if i >= 0 {
        tasks[i] = Task { id: id, title: tasks[i].title, done: !tasks[i].done }
        message = ""
        save()
        ui.refresh()
    }
}

fn removeTask(id: int) {
    let i = indexOfId(id)
    if i >= 0 {
        remove(tasks, i)
        save()
        ui.refresh()
    }
}

fn clearDone() {
    let before = tasks.len()
    tasks = list.filter(tasks, |t| !t.done)
    message = if before == tasks.len() { "nothing to clear" }
              else { "cleared ${before - tasks.len()}" }
    save()
    ui.refresh()
}

fn indexOfId(id: int) -> int {
    for i in 0..tasks.len() {
        if tasks[i].id == id {
            return i
        }
    }
    return -1
}

// ── talking to a server ───────────────────────────────────────────────
//
// Both outcomes are handled, so there is no path where a failed request quietly
// leaves the page as it was.

fn sync() {
    message = "syncing…"
    ui.refresh()
    fetch.post("/api/tasks", toJson(),
        |body| {
            message = match json.parse(body) {
                Err(e)  => "server sent something odd: ${e}",
                Ok(doc) => "synced ${fieldInt(doc, "saved")}",
            }
            ui.refresh()
        },
        |why| {
            message = "sync failed: ${why}"
            ui.refresh()
        })
}

// ── persistence ───────────────────────────────────────────────────────
//
// std/json is ordinary Klang with no FFI, so it works in a browser unchanged.

fn toJson() -> string {
    let mut items: [json.Json] = []
    for t in tasks {
        push(items, Obj([
            json.field("id", json.numOf(t.id)),
            json.field("title", Str(t.title)),
            json.field("done", Bool(t.done)),
        ]))
    }
    return json.stringify(Arr(items))
}

fn fieldText(doc: json.Json, key: string) -> string {
    return match json.lookup(doc, key) {
        Some(v) => match json.asString(v) { Some(s) => s, None => "" },
        None    => "",
    }
}

fn fieldInt(doc: json.Json, key: string) -> int {
    return match json.lookup(doc, key) {
        Some(v) => match json.asFloat(v) { Some(n) => toInt(n), None => 0 },
        None    => 0,
    }
}

fn fieldBool(doc: json.Json, key: string) -> bool {
    return match json.lookup(doc, key) {
        Some(v) => match json.asBool(v) { Some(b) => b, None => false },
        None    => false,
    }
}

fn load() {
    let saved = dom.stored(STORE_KEY)
    if saved == "" {
        push(tasks, Task { id: 1, title: "write a language", done: true })
        push(tasks, Task { id: 2, title: "give it a garbage collector", done: true })
        push(tasks, Task { id: 3, title: "make it run in a browser", done: false })
        nextId = 4
        return
    }
    match json.parse(saved) {
        Err(e) => dom.warn("stored tasks are not readable (${e}) — starting fresh")
        Ok(doc) => {
            for item in json.items(doc) {
                let id = fieldInt(item, "id")
                push(tasks, Task { id: id, title: fieldText(item, "title"),
                                   done: fieldBool(item, "done") })
                nextId = if id >= nextId { id + 1 } else { nextId }
            }
        }
    }
}

fn save() {
    dom.store(STORE_KEY, toJson())
}

// ── styling ───────────────────────────────────────────────────────────
//
// The property names are functions, so a misspelling is a compile error rather
// than a rule the browser quietly drops.

fn styles() -> [css.Block] {
    return [
        css.rule(":root", [css.colorScheme("light dark")]),
        css.rule("body", [
            css.font("16px/1.5 system-ui, sans-serif"),
            css.maxWidth("34rem"),
            css.margin("3rem auto"),
            css.padding("0 1rem"),
        ]),
        css.rule("h1", [css.fontSize("1.4rem"), css.marginBottom(".2rem")]),
        css.rule(".sub", [css.marginTop("0"), css.opacity(".7"), css.fontSize(".9rem")]),

        css.rule("form", [css.display("flex"), css.gap(".5rem"), css.margin("1.2rem 0 .8rem")]),
        css.rule("input", [
            css.flex("1"), css.padding(".5rem .7rem"),
            css.border("1px solid #8886"), css.radius(".4rem"),
            css.background("transparent"), css.color("inherit"), css.font("inherit"),
        ]),
        css.rule("button", [
            css.padding(".5rem .9rem"), css.border("1px solid #8886"),
            css.radius(".4rem"), css.background("transparent"),
            css.color("inherit"), css.font("inherit"), css.cursor("pointer"),
        ]),
        css.rule("button:hover", [css.background("#8882")]),

        css.rule("nav", [css.display("flex"), css.gap(".4rem"),
                         css.fontSize(".85rem"), css.marginBottom(".8rem")]),
        css.rule("nav a", [css.padding(".2rem .6rem"), css.radius(".3rem"),
                           css.textDecoration("none"), css.color("inherit"),
                           css.opacity(".6")]),
        css.rule("nav a.on", [css.opacity("1"), css.background("#8883")]),

        css.rule("ul", [css.listStyle("none"), css.padding("0"), css.margin("0"),
                        css.border("1px solid #8884"), css.radius(".5rem")]),
        css.rule("li", [css.display("flex"), css.align("center"), css.gap(".6rem"),
                        css.padding(".45rem .6rem"), css.borderBottom("1px solid #8882")]),
        css.rule("li:last-child", [css.borderBottom("0")]),
        css.rule("li span", [css.flex("1")]),
        css.rule("li.done span", [css.opacity(".45"), css.textDecoration("line-through")]),
        css.rule("li.empty", [css.opacity(".5"), css.fontStyle("italic"),
                              css.justify("center")]),
        css.rule("li button", [css.border("0"), css.padding(".15rem .45rem"),
                               css.fontSize("1rem"), css.opacity(".6")]),
        css.rule("li button:hover", [css.opacity("1")]),

        css.rule(".status", [css.display("flex"), css.justify("space-between"),
                             css.align("center"), css.gap(".5rem"),
                             css.fontSize(".85rem"), css.opacity(".75"),
                             css.marginTop(".8rem")]),
        css.rule(".status .message", [css.flex("1"), css.textAlign("center")]),
        css.rule(".status button", [css.padding(".3rem .6rem")]),

        css.media("(max-width: 30rem)", [
            css.rule("body", [css.margin("1.5rem auto")]),
            css.rule("h1", [css.fontSize("1.2rem")]),
        ]),
    ]
}

// Readable from JavaScript, so the host page can ask Klang how it is doing.
export fn remaining() -> int {
    return list.count(tasks, |t| !t.done)
}

fn main() {
    load()
    dom.setTitle("Klang in the browser")
    dom.useStyle(css.sheet(styles()))

    // The address bar is state like any other: set it, then re-render.
    ui.onRoute(|r| {
        filter = if r == "done" { "done" } else if r == "todo" { "todo" } else { "all" }
        ui.refresh()
    })

    ui.mount("#app", view)
    dom.log("klang: ready, ${tasks.len()} tasks")
}
